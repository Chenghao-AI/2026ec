  59          void main()
  60          {        
  61   1              F =350;   // F为频率值的十倍（MHz）
  62   1              LCD_Init();                     // 液晶初始化
  63   1              ADF4351_Init(F);    // 起始频率设置为35M
  64   1              //显示
  65   1              LCDWrite_word("THE Fout IS :"); 
  66   1              LCD_Play(0x42,F);
  67   1              LCDWrite_com(0x80+0x48);
  68   1              LCDWrite_word("MHz");
  69   1              //显示  
  70   1              while(1) 
  71   1              {
  72   2                      KEY();           // 检测是否有按键按下
  73   2                      if(k)       // 有按键按下，改变频率
  74   2                      {
  75   3                              k = 0;                          
  76   3                              if (F>=690&&F<=1370)     ADF4351_Wdata(0x0050443c);  // if,else if中得语句是判断此时频率得范围            
  77   3                              else if (F>1370&&F<=2740) ADF4351_Wdata(0x0040443c); // 根据频率的范围确定我们要更新此时寄存器4的值
  78   3                              else if (F>2740&&F<=5490) ADF4351_Wdata(0x0030143c);
  79   3                              else if (F>5490&&F<=10990) ADF4351_Wdata(0x0020143c); 
  80   3                              else if (F>10990&&F<=21990) ADF4351_Wdata(0x0010143c); 
  81   3                      else if (F>21990)  ADF4351_Wdata(0x0000143c); 
  82   3                              else ADF4351_Wdata(0x0060a43c); 
  83   3                                                                                                                                      
  84   3                              LCD_Play(0x42,F);                                               // 显示此时的频率
  85   3                              LCDWrite_com(0x80+0x40+j);
  86   3                              ADF4351_Wdata(0x00000000|F<<15);           // 把要输出频率的字写入寄存器0，改变输出频率
  87   3                      
  88   3                      }
  89   2                      
  90   2              }
  91   1              
  92   1      }                                                                                                                                                                
