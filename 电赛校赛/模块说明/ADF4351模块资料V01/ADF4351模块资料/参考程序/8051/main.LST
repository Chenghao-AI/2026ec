 109          void KEY()
 110          {
 111   1              if(!k1 || !k2 || !k3 || !k4)     // 有键按下
 112   1              {
 113   2                      Delay_ms(20);
 114   2         // 选择频率变化位            
 115   2                      if(!k1)                        
 116   2                      {
 117   3                              while(!k1);                  // 等待按键释放  
