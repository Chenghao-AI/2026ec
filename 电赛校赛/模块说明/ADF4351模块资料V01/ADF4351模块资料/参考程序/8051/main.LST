 149   3                      }
 150   2                      // 频率对应位的数值加减一
 151   2                      if(!k3)
 152   2                      {
 153   3                              while(!k3);                      // 等待按键释放
 154   3                              switch(j)
 155   3                              {
 156   4                                      case 7:                    // 频率值减0.1MHz
 157   4                                              F-=1;
 158   4                                              break;
 159   4                                      case 5:                    // 频率值减1MHz
 160   4                                              F-=10;
 161   4                                           break;
 162   4                                      case 4:                    // 频率值减10MHz
 163   4                                              F-=100;
 164   4                                           break;
 165   4                                      case 3:                    // 频率值减100MHz
 166   4                                              fs=F/1000;
 167   4                                        if(fs!=0)                // 频率值大于99MHz，允许频率值减少
 168   4                                              F-=1000;
 169   4                                           break;
 170   4                                      case 2:                    // 频率值减1000MHz
 171   4                                              fs=F/10000;
 172   4                                        if(fs!=0)                                            // 频率值大于999MHz，允许频率值减少
 173   4                                              F-=10000;
 174   4                                           break;
 175   4                                      default:break;
 176   4                     }
 177   3                              k = 1;
