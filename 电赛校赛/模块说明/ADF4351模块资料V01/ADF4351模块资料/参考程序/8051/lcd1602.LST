  87          // 注意事项:
  88          //-----------------------------------------------------------------
  89          void LCDWrite_data(uchar date)
  90          {       
  91   1              lcdrs=1;
  92   1              lcdrw=0;
  93   1              lcddat=date;
  94   1              Delay_ms(5);
  95   1              lcden=1;
  96   1              Delay_ms(5);
  97   1              lcden=0;
  98   1      }
  99          void LCDWrite_word(unsigned char *s)
 100          {
 101   1              while(*s>0)
 102   1              {
 103   2                      LCDWrite_data(*s);
 104   2                      s++;
 105   2              }
 106   1      }
 107          void LCD_Play(uchar add,uint dat)
 108          {
 109   1              uchar i;
 110   1              uchar wei[6];
 111   1              wei[0] = (dat/10000%10)+48;     
 112   1              wei[1] = (dat/1000%10)+48;                      //千
 113   1              wei[2] = (dat/100%10)+48;                       //百
 114   1              wei[3] = (dat/10%10)+48;                                //十
 115   1              wei[4] ='.'     ;
 116   1              wei[5] = (dat%10)+48;                                   //个
 117   1              LCDWrite_com(0x80+add);
