  37          //-----------------------------------------------------------------------------
  38          // void Delay_ms(uint z)
  39          //-----------------------------------------------------------------------------
  40          //
  41          // 函数功能: 时基为1ms的延时
  42          // 例子提示: 调用Delay_ms(20),得到20ms延时
  43          // 入口参数: 无符号8bit整数
  44          // 返回参数: 无
  45          // 全局变量: 无
  46          // 注意事项: 基于使用11.0592MHz晶振的51单片机
  47          //-----------------------------------------------------------------------------
  48          void Delay_ms(uint z)
  49          {
  50   1              uint x,y;
  51   1              for(x=z;x>0;x--)
  52   1                      for(y=110;y>0;y--);
  53   1      }
