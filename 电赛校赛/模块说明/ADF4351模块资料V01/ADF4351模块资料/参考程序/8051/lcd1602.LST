  56          //-----------------------------------------------------------------
  57          // void LCDWrite_com(uchar com)
  58          //-----------------------------------------------------------------
  59          //
  60          // 函数功能: 写LCD的指令代码
  61          // 入口参数: LCD指令
  62          // 返回参数: 无
  63          // 全局变量: 无   
  64          // 注意事项:
  65          //-----------------------------------------------------------------             
  66          void LCDWrite_com(uchar com)
  67          {
  68   1              lcdrs=0;
  69   1              lcdrw=0;
  70   1              lcddat=com;
  71   1              Delay_ms(5);
  72   1              lcden=1;
  73   1              Delay_ms(5);
  74   1              lcden=0;
  75   1      }
