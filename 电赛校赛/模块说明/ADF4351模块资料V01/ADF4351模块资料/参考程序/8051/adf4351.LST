   9          // 调试工具: 51单片机
  10          // 说    明: 
  11          //     (1)调试使用的系统时钟频率Fsysclk=11.0592MHz
  12          //     (2)硬件连接：
  13          //                                                      CLK  ->  P1.7
  14          //                                                      DATA ->  P1.6   
  15          //                                                      LE   ->  P1.5   
  16          //                                                      CE   ->  P1.4
  17          //               (3)设置频率超过模块实际最大输出频率时，设置无效，任然输出模块最大频率;     
  18          //-----------------------------------------------------------------------------
  19          
  20          
  21          //-----------------------------------------------------------------------------
  22          // 头文件包含
  23          #include "adf4351.h"
  24          #include "delay.h"
  25          //-----------------------------------------------------------------
  26          // 初始化程序区
  27          //-----------------------------------------------------------------
  28          // 变量申明
  29          //-----------------------------------------------------------------
  30          ulint R=125; // R为参考分配器的数值，计算公式：输入频率/（2*R）=0.1  
  31                               // 注：输入频率的单位为MHz，R的范围为0~1023的整数
  32                                   // 默认输入频率为板载25M晶振，故得R为125。
  33          //-----------------------------------------------------------------
  34          // ADF4351_Init(ulint cf)
  35          //-----------------------------------------------------------------
  36          //
  37          // 函数功能: adf4351初始化
  38          // 入口参数: ulint date   //初始输出频率为35Mhz
  39          // 返回参数: 无
  40          // 全局变量: 无   
  41          // 注意事项: 
  42          //  
  43          //-----------------------------------------------------------------
  44          void ADF4351_Init(ulint date)
  45          {
  46   1              ADF_CE = 1;
  47   1              delay_us(5);
  48   1              ADF_CLK = 0;
  49   1              ADF_LE = 1;
  50   1              ADF_DATA = 0;   
  51   1              ADF4351_Wdata(0x00580005);       // 设置寄存器5 ：LD设置为数字锁定监测模式
  52   1              ADF4351_Wdata(0x0060a43c);       // 设置寄存器4 : 差分输出功率设置为5dbm，使能静音至检测到锁定，频段选择时钟设
             -为10K 
  53   1              ADF4351_Wdata(0x006004b3);       // 设置寄存器3 ：charge cancellation，ABP设为1
  54   1          ADF4351_Wdata(0x0D003Fc2| R<<14);    // 设置寄存器2：电荷泵电流设为5mA，LDP,LDF设为1。
C51 COMPILER V9.00   ADF4351                                                               07/28/2019 21:31:17 PAGE 2   

  55   1              ADF4351_Wdata(0x08008011);                       //     设置寄存器1 ：预分配器设为8/9，使能输出分频
  56   1              ADF4351_Wdata(0x00000000|date<<15);      // N分配器数据写入寄存器R0 
  57   1      
  58   1      }
  59          //-----------------------------------------------------------------
  60          // 功能程序区
  61          //-----------------------------------------------------------------
  62          
  63          
  64          //-----------------------------------------------------------------
  65          // ADF4351_Wdata(ulint dat)
  66          //-----------------------------------------------------------------
  67          //
  68          // 函数功能: 写数据到adf4351
  69          // 入口参数: 无
  70          // 返回参数: 无
  71          // 全局变量: 无   
  72          // 注意事项: 
  73          //     
  74          //-----------------------------------------------------------------
  75          void ADF4351_Wdata(ulint dat)
  76          {
  77   1              uchar i;
  78   1              ADF_CLK = 0;
  79   1              ADF_LE = 0;
  80   1              for(i=0; i<32; i++)
  81   1              {
  82   2                      if( dat & 0x80000000 )
  83   2                              ADF_DATA = 1;
  84   2                      else
  85   2                              ADF_DATA = 0;   
  86   2                      dat <<= 1;              
  87   2                      ADF_CLK = 1;
  88   2                      ADF_CLK = 0;    
  89   2              }
  90   1              ADF_LE = 1;     
  91   1      }
